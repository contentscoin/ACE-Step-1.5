# Product-layer build/tooling artefacts (design §1.4.2: independent toolchain)
node_modules/

# The repository root ignores package-lock.json for the VitePress docs toolchain.
# The product layer needs a committed lockfile for reproducible CI installs, so
# the parent rule is reversed here only for this tree.
!package-lock.json
build/
coverage/
*.tsbuildinfo

# DSP worker
dsp/.venv/
dsp/**/__pycache__/
dsp/.pytest_cache/
dsp/.hypothesis/
dsp/*.egg-info/
dsp/src/*.egg-info/

# Web SPA (task 7.1). `web/package-lock.json` is committed for the same reason the
# product layer's is: CI installs must be reproducible.
web/node_modules/
web/dist/
