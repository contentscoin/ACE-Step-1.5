{
  "name": "musicstudio",
  "version": "0.0.0",
  "private": true,
  "description": "MusicStudio product layer — self-contained service (design §1.4.1). Independent of the host ACE-Step repository toolchain.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:property": "vitest run test/property",
    "test:db": "vitest run --no-file-parallelism test/integration/db-schema.test.ts test/integration/account-repository-contract.test.ts test/integration/asset-store-contract.test.ts",
    "check:boundary": "eslint . && python3 dsp/scripts/check_import_boundary.py",
    "check:properties": "node scripts/audit-properties.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "fast-check": "^4.5.0",
    "pg": "^8.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "fastify": "^5.11.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.5"
  }
}
